{
  "name": "@etsoo/restclient",
  "version": "1.1.40",
  "description": "TypeScript REST client wrapup built-in Fetch",
  "main": "lib/cjs/index.js",
  "module": "lib/mjs/index.js",
  "types": "lib/mjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/mjs/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ETSOO/restclient.git"
  },
  "keywords": [
    "REST",
    "API",
    "fetch",
    "TypeScript",
    "ETSOO",
    "SmartERP",
    "司友云平台",
    "青岛亿速思维",
    "上海亿商"
  ],
  "author": "Garry Xiao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ETSOO/restclient/issues"
  },
  "homepage": "https://github.com/ETSOO/restclient#readme",
  "dependencies": {
    "@etsoo/shared": "^1.2.91"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime-corejs3": "^8.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vitest-fetch-mock": "^0.4.5"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true
  }
}
